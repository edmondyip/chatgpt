---
import { experiences } from "../lib/experiences";
const { glasswater } = experiences;
---
<article class="feature">
  <img src={glasswater.preview.image} width={glasswater.preview.width} height={glasswater.preview.height} alt="" fetchpriority="high"/>
  <div><p class="kicker">Free interactive showcase</p><h2>{glasswater.title}</h2>
  <p>Disturb the waves, move the sun and see how light reaches the seabed.</p>
  <p class="actions"><a class="launch" href={glasswater.route}>Experience Glasswater <span aria-hidden="true">↗</span></a>
  <a href={glasswater.sourceUrl}>View source</a></p></div>
</article>
<style>
.feature { display:grid; position:relative; isolation:isolate; overflow:hidden; background:#152b37; color:#fff8e5; margin:1.25rem 0; }
img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:-2; }
.feature::before { content:""; position:absolute; inset:0; background:linear-gradient(90deg,#10222ef5, #10222ed4 37%, transparent 78%); z-index:-1; }
div { padding:clamp(1.25rem,4vw,3rem); max-width:30rem; }
.actions { display:flex; flex-wrap:wrap; align-items:center; gap:.65rem 1rem; margin-bottom:0; }
.launch { padding:.55rem .9rem; background:#fff8e5; color:#152b37; font-weight:700; text-decoration:none; }
.launch:hover { text-decoration:underline; }
a:focus-visible { outline-color:#fff8e5; }
@media(max-width:650px) {
  img { position:static; height:auto; }
  .feature::before { display:none; }
  div { padding:1rem; }
}
</style>
