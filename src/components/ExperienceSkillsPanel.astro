---
import AnalyticsConsent from "./AnalyticsConsent.astro";
import SkillsInstallCommand from "./SkillsInstallCommand.astro";
import { cinematicSkills, cinematicSkillsRepository, type Experience } from "../lib/experiences";
interface Props { experience: Experience; id: string }
const { experience, id } = Astro.props;
---
<dialog {id} class="skills-panel" aria-labelledby={`${id}-heading`}>
  <header>
    <h2 id={`${id}-heading`}>{experience.title}</h2>
    <form method="dialog"><button class="close" type="submit" aria-label="Close skills panel" title="Close skills panel" autofocus>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
    </button></form>
  </header>
  <p>Free, open-source skills for AI coding agents.</p>
  <ul>
    {experience.skills.map(skill => (
      <li><a href={`${cinematicSkillsRepository}/blob/main/skills/${skill}/SKILL.md`} target="_blank" rel="noopener">{cinematicSkills[skill]}</a></li>
    ))}
  </ul>
  <SkillsInstallCommand/>
  <a href={`${cinematicSkillsRepository}#quick-start`} target="_blank" rel="noopener">Installation guide ↗</a>
  <button id="analytics-settings" type="button" aria-controls="analytics-consent" aria-expanded="false">Analytics preferences</button>
  <AnalyticsConsent onRequest/>
</dialog>
<style>
  .skills-panel {
    box-sizing: border-box;
    width: min(31rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    padding: clamp(.9rem, 4vw, 1.5rem);
    color: var(--experience-ink);
    background: var(--experience-panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    font: 14px/1.5 var(--experience-sans);
    color-scheme: dark;
  }
  .skills-panel::backdrop { background: #07101470; }
  header { display: flex; align-items: start; justify-content: space-between; gap: .5rem; }
  h2 { margin: 0; font: 1.65rem/1.15 var(--experience-serif); }
  p { margin: .45rem 0; }
  a { color: inherit; text-underline-offset: .2em; }
  ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr)); padding: 0; margin: .7rem 0; list-style: none; }
  li a { display: flex; align-items: center; min-height: 44px; }
  :global(.skills-panel button) { font: inherit; cursor: pointer; }
  .close, #analytics-settings {
    background: none;
    color: inherit;
    border: 1px solid var(--line);
    border-radius: 5px;
    min-height: 44px;
  }
  .close { display: grid; place-items: center; width: 44px; }
  .close svg { width: 18px; height: 18px; }
  #analytics-settings { display: block; margin-top: .65rem; padding: .25rem .65rem; }
  .skills-panel :global(#analytics-consent) { border-top: 1px solid var(--line); margin-top: .65rem; padding-top: .65rem; }
  .skills-panel :global(#analytics-consent button) { min-height: 44px; }
</style>
