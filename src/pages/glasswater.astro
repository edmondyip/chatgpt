---
import scene from "../../prototypes/glasswater/lagoon/Glasswater-v15.html?raw";
import ExperienceShell from "../layouts/ExperienceShell.astro";
import { experiences } from "../lib/experiences";
const { glasswater } = experiences;
---
<ExperienceShell experience={glasswater}>
  <iframe id="glasswater-renderer" title={glasswater.title} srcdoc={scene} aria-describedby="glasswater-requirements"></iframe>
  <span id="glasswater-requirements" hidden>{glasswater.browserRequirements}</span>
</ExperienceShell>
<script>
  import chrome from "../styles/glasswater-embedded.css?raw";

  const frame = document.querySelector<HTMLIFrameElement>("#glasswater-renderer");
  if (frame) {
    function arrangeChrome() {
      const scene = frame?.contentDocument;
      if (scene?.URL !== "about:srcdoc" || scene.getElementById("embedded-chrome")) return;
      const style = scene.createElement("style");
      style.id = "embedded-chrome";
      style.textContent = chrome;
      scene.head.append(style);
    }
    frame.addEventListener("load", arrangeChrome);
    arrangeChrome();
  }
</script>
