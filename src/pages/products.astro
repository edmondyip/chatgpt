---
import GlasswaterFeature from "../components/GlasswaterFeature.astro";
import Base from "../layouts/Base.astro";
import Catalog from "../components/Catalog.astro";
import Support from "../components/Support.astro";
import experiments from "../../data/experiments.json";
import glasswater from "../../data/glasswater.json";
---
<Base title="Experiences, Open Source & Products" description="Explore free interactive showcases, reusable code and downloadable products from AI Survival."><div class="wrap inner">
<h1>The <em>workbench.</em></h1>
<section class="block" id="experiences">
  <h2>Experiences</h2>
  <p>Free interactive showcases and browser tools.</p>
  <GlasswaterFeature/>
  <Catalog/>
</section>
<section class="block" id="open-source">
  <h2>Open Source</h2>
  <article class="entry">
    <h3>{glasswater.title}</h3>
    <p>MIT-licensed WebGL 2 source for the lagoon, with an annotated renderer, integration examples and the standalone visual reference.</p>
    <a href={glasswater.sourceUrl}>View Glasswater source on GitHub</a>
  </article>
  <article class="entry">
    <h3>Cinematic Skills</h3>
    <p>Six MIT-licensed agent skills for interactive water, underwater optics, floating objects and procedural lighting, with runnable examples.</p>
    <div class="install-command">
      <code id="cinematic-install-command">npx skills add edmondyip/cinematic-skills</code>
      <button id="copy-cinematic-install" type="button" hidden>Copy command</button>
    </div>
    <div id="cinematic-install-status" role="status"></div>
    <a href={glasswater.skillsUrl}>Browse Cinematic Skills on GitHub</a>
  </article>
</section>
<section class="block" id="products">
  <h2>Products</h2>
  <p>Downloadable products and community support.</p>
  <Support/>
</section>
<section class="block"><h2>Experiment log</h2>{experiments.map(e=><article class="entry"><p class="kicker">{e.status}</p><h3>{e.name}</h3><p>{e.description}</p><p>{e.next}</p></article>)}</section>
</div></Base>


<style>
  .install-command {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem .75rem;
    margin-bottom: .5rem;
  }
  .install-command code {
    padding: .4rem .6rem;
    border: 1px solid var(--line);
    overflow-wrap: anywhere;
  }
  .install-command button {
    min-height: 2.75rem;
    cursor: pointer;
  }
  #cinematic-install-status:not(:empty) {
    margin-bottom: .5rem;
  }
</style>

<script>
  const command = document.querySelector("#cinematic-install-command");
  const button = document.querySelector<HTMLButtonElement>("#copy-cinematic-install");
  const status = document.querySelector("#cinematic-install-status");
  if (command && button && status && navigator.clipboard?.writeText) {
    button.hidden = false;
    button.addEventListener("click", async () => {
      status.textContent = "";
      try {
        await navigator.clipboard.writeText(command.textContent?.trim() ?? "");
        status.textContent = "Command copied.";
      } catch {
        status.textContent = "Select and copy the command manually.";
      }
    });
  }
</script>
