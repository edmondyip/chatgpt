---
import GlasswaterFeature from "../components/GlasswaterFeature.astro";
import SkillsInstallCommand from "../components/SkillsInstallCommand.astro";
import glasswater from "../../data/glasswater.json";
import Base from "../layouts/Base.astro";
import journal from "../../data/journal.json";
import { current, target, coverage, percent } from "../lib/ledger";
import support from "../../data/support.json";
import Support from "../components/Support.astro";
const latest = [...journal].sort((a,b) => b.date.localeCompare(a.date))[0];
const progress = percent(coverage(current));
---
<Base title="Can AI earn enough to pay for itself?" description="Follow a human-owned experiment to earn US$20 a month with AI. Read the field notes, product experiments and public financial ledger.">
<div class="wrap">
<GlasswaterFeature/>
<section class="skills-feature" aria-labelledby="cinematic-skills-heading">
  <h2 id="cinematic-skills-heading">Cinematic Skills</h2>
  <p>Six free, open-source skills for AI coding agents, drawn from Glasswater.</p>
  <SkillsInstallCommand/>
  <a href={glasswater.skillsUrl} target="_blank" rel="noopener">Browse the six skills on GitHub</a>
</section>
<nav class="discovery" aria-label="Browse the workbench">
  <a href="/products/#experiences">Experiences</a>
  <a href="/products/#open-source">Open Source</a>
  <a href="/products/#products">Products</a>
</nav>
<section class="hero"><div class="hero-copy"><p class="kicker"><b class="signal"></b> Independent field journal</p>
<h1>Can AI earn<br/>enough to pay<br/><em>for itself?</em></h1>
<p class="intro">One human owner and two AI roles, working toward a first paying customer and a US$20 monthly target.</p>
<div class="hero-actions"><a class="button" href="/releaseproof/">Try ReleaseProof for free</a>
<a href={support.availability === "available" ? support.checkoutUrl : "#support"}>Support the experiment</a></div></div>
<figure class="plate"><div class="plate-top"><span>Financial objective</span><span>USD</span></div>
<img class="note" src="/target-note.webp" width="1088" height="728" fetchpriority="high" alt="Illustrated twenty-dollar note bearing the words Monthly Target."/>
<figcaption><span class="cross">+</span> Illustrative note &nbsp;/&nbsp; Monthly target <span class="cross">+</span></figcaption></figure></section>
<section class="strip" aria-label="Current financial position"><div><span>Monthly target</span><strong>US${target / 100}</strong></div><div><span>Target coverage</span><strong class="status">{progress}</strong></div><div><span>Accounting period</span><strong>{current.label}</strong></div><a href="/finances/">View ledger</a></section>
<section class="home-grid"><div><p class="kicker">From the journal</p><h2><a href={"/journal/#"+latest.id}>{latest.title}</a></h2><p>{latest.summary}</p><small>{latest.date}</small></div><div><p class="kicker">Free browser tool</p><h2><a href="/releaseproof/">ReleaseProof</a></h2><p>Review a coding agent’s checklist beside the evidence you have on hand.</p></div></section>
<Support/>
<section class="roles"><p class="kicker">Who does the work?</p><p>ChatGPT develops experimental prototypes. Codex builds, tests and releases them for the web. The human owner approves what goes on sale, publishes updates and verifies the money.</p><a href="/about/">Read the experiment rules</a></section>
</div></Base>

<style>
.skills-feature { border-block: 1px solid var(--line); padding-block: 1.25rem; margin-bottom: .75rem; }
.skills-feature p { margin: .5rem 0 .75rem; }
.discovery { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
.discovery a { padding-block: .5rem; }
</style>
