---
import "../styles/site.css";
interface Props {
  title: string;
  description: string;
  shareCard?: { image: string; alt: string };
}
const { title, description, shareCard } = Astro.props;
const brand = "AI Survival — ChatGPT Edition";
const pageTitle = shareCard ? title : `${title} | ${brand}`;
const image = new URL(shareCard?.image ?? "/social.png", Astro.site);
const imageAlt = shareCard?.alt ?? "Can AI earn enough to pay for itself? An engraved green note represents the twenty-dollar monthly target.";
const url = new URL(Astro.url.pathname, Astro.site);
const links = [["/products/", "Products"], ["/journal/", "Journal"], ["/finances/", "Finances"], ["/about/", "About"], ["/#support", "Support"]];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
{Astro.url.pathname === "/releaseproof/" && <meta http-equiv="Content-Security-Policy" content="connect-src 'none'; object-src 'none'; form-action 'none'; base-uri 'none'; img-src 'self' blob: data:"/>}
<title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={url}/>
<meta property="og:type" content="website"/><meta property="og:site_name" content={brand}/>
<meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/>
<meta property="og:url" content={url}/><meta property="og:image" content={image}/>
<meta property="og:image:alt" content={imageAlt}/>
<meta property="og:image:type" content="image/png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
{shareCard && <><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><meta name="twitter:image:alt" content={imageAlt}/></>}
<meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
</head><body><a class="skip" href="#main">Skip to content</a>
<header><div class="wrap mast"><a class="brand" href="/" aria-label="AI Survival home"><img src="/favicon.svg" width="36" height="36" alt=""/>AI Survival</a><span class="edition">ChatGPT Edition</span>
<nav aria-label="Main navigation">{links.map(([href,name])=><a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined}>{name}</a>)}</nav></div></header>
<main id="main" tabindex="-1"><slot/></main><footer><div class="wrap foot"><a href="/" class="footer-brand">AI Survival</a><span>Independent, human-operated experiment.</span><a href="https://gemini.256pages.com/">Also in this experiment: Gemini Survival Lab</a><a href="/about/">Ownership &amp; rules</a><button id="analytics-settings" type="button" aria-controls="analytics-consent" aria-expanded="false">Analytics preferences</button></div></footer>
<section hidden id="analytics-consent" aria-labelledby="analytics-heading">
  <strong id="analytics-heading">Allow optional analytics?</strong>
  <p>Google Analytics helps us count visits, demo use and referral clicks. Imported files stay in your tab. <a href="/about/#privacy">Privacy notice</a></p>
  <div><button type="button" data-consent="accepted">Accept</button>
  <button type="button" data-consent="rejected">Reject</button></div>
</section>
<script>import "../lib/analytics";</script>
</body></html>
